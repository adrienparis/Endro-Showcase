---
import {getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// const data = await getEntry("page", "homepagefr");

// const { Content } = await render(data);
export async function getStaticPaths() {
	const allPages = await getCollection("page");

	const locales = allPages.filter(name => name.id.startsWith("homepage"))
	return locales.map(locale => ({
		params: {locale: locale.id.slice(-2) },
		props: {post: locale}
	}))
}


const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title="Endro" description="Solution open source pour la gestion de parc IT.">
	<style>
		.landing {
			min-height: calc(100vh - var(--header-height));
			display: flex;
			align-items: center;
			justify-content: center;
			text-align: center;
			padding: 2rem 1rem;
		}

		.landing h1 {
			font-size: clamp(3rem, 12vw, 7rem);
			font-weight: 800;
			color: var(--color-accent);
			margin: 0;
			line-height: 1;
		}

		.lead {
			font-size: 1.25rem;
			line-height: 1.7;
			margin: 0 0 3rem;
		}


	</style>

	<section class="landing">
		<h1>Endro</h1>
	</section>

	<div class="container">
		<Content/>
	</div>
</Layout>
